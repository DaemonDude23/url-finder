FROM docker.io/library/golang:1.27.3@sha256:e519d3b0a5b285e5aa53ab9eef02bc6bbb9cb04608389b743a136a9ce75f0d1e AS builder
ARG VERSION=dev
WORKDIR /app
COPY ./src/go.mod ./src/go.sum ./
RUN go mod download
COPY ./src/ ./
RUN CGO_ENABLED=0 go build -ldflags="-X main.version=${VERSION}" -o url-finder .
# renovate: datasource=go depName=github.com/go-delve/delve
ARG DELVE_VERSION=v1.27.2
RUN go install github.com/go-delve/delve/cmd/dlv@${DELVE_VERSION}
USER 65532:65532
COPY ./examples/ /app/examples/
EXPOSE 40000
CMD ["dlv", "exec", "/app/url-finder", "--headless", "--listen=:40000", "--api-version=2", "--", "/app/examples/"]
